# Application Environment Configuration
APP_NAME="Global Language Academy Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# AI Provider Configuration
# Supported providers: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI API Settings (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG & Routing Settings
SIMILARITY_THRESHOLD=0.20
TOP_K_CHUNKS=3
ENABLE_DETERMINISTIC_TIER=true
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=600

# Cache Configuration
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=500

# Escalation & Notification Webhook (Optional Slack/Telegram/Discord webhook URL)
ESCALATION_WEBHOOK_URL=
